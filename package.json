{
  "name": "zaton-finance",
  "productName": "ZatonFinance",
  "version": "1.0.0",
  "private": true,
  "description": "Локальный финансовый трекер для «Затон Рыбака» и «Арт Фокус» в стиле X",
  "author": {
    "name": "gjjut",
    "email": "noreply@github.com"
  },
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run test && npm run build:renderer && npm run build:electron",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:dir": "npm run build && electron-builder --dir",
    "bump": "node scripts/bump-version.mjs",
    "release:notes": "node scripts/changelog-section.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "ru.gjjut.zatonfinance",
    "productName": "ZatonFinance",
    "copyright": "Copyright © 2026 gjjut",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Финансы компаний",
      "deleteAppDataOnUninstall": false,
      "artifactName": "ZatonFinance-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ZatonFinance-Portable-${version}.${ext}"
    }
  }
}
